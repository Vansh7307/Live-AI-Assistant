# ── LLM providers ────────────────────────────────────────────────────────────
# You need at least ONE. Providers are tried in the order listed in
# LLM_PROVIDERS; if the first fails (quota/network) the next configured
# provider is used as a fallback.
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Comma-separated provider order. Only those with a key set are active.
LLM_PROVIDERS=gemini,openai,anthropic
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Web search ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ── Auth & rate limiting ─────────────────────────────────────────────────────
# Set this to require an X-API-Key header on /chat and /chat/stream.
APP_API_KEY=
# Per-IP rate limit for chat endpoints.
CHAT_RATE_LIMIT=20/minute
# Cache duplicate web-search queries briefly. Set 0 to disable.
SEARCH_CACHE_TTL_SECONDS=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ── Persistence ──────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use SQLite (single-instance dev/local).
# For production multi-instance use a Postgres URL, e.g.:
#   postgresql+psycopg://user:pass@host:5432/db
# Any postgres:// URL (Render/Heroku) is auto-upgraded to the psycopg driver.
# DATABASE_URL=
MEMORY_DB_PATH=          # SQLite path override (default: ./memory/memory.sqlite3)

# ── Safety / moderation ──────────────────────────────────────────────────────
SAFETY_ENABLED=true
INPUT_INJECTION_THRESHOLD=0.6
# Comma-separated terms that, if present in an answer, cause a refusal.
OUTPUT_BLOCKLIST=

# ── Observability ────────────────────────────────────────────────────────────
# Exposed at /metrics (Prometheus scrape target).
METRICS_ENABLED=true

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30
